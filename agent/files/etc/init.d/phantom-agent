#!/bin/sh /etc/rc.common
# phantom-agent: daily limit and usage time for the Phantom Network app

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/phantom/agent.uc
	# local time (for midnight and schedules)
	[ -s /tmp/TZ ] && procd_set_param env TZ="$(cat /tmp/TZ)"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# time zone changed → restart
	procd_add_reload_trigger system
}

reload_service() {
	stop
	start
}

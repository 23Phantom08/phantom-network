<?xml version="1.0" encoding="utf-8"?>
<!-- Cudys im Heimnetz sprechen standardmäßig HTTP (wie die Weboberfläche). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
